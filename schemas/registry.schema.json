{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DockyardMods/the-dockyard/refs/heads/main/schemas/registry.schema.json",
  "title": "Dockyard Mod Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "currentGameVersionId", "mods"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./schemas/registry.schema.json"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "currentGameVersionId": {
      "type": "string",
      "minLength": 1
    },
    "mods": {
      "type": "array",
      "items": {
        "$ref": "./mod-entry.schema.json"
      }
    }
  }
}
