{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DockyardMods/the-dockyard/refs/heads/main/schemas/mod-manifest.schema.json",
  "title": "Dockyard Mod Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "name",
    "summary",
    "version",
    "authors",
    "gameVersionId",
    "packages"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gameVersionId": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./mod-package.schema.json"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changelog": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "./mod-dependency.schema.json"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "./mod-media.schema.json"
      }
    }
  }
}
