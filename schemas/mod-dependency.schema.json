{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dockyardmods.github.io/the-dockyard/schemas/mod-dependency.schema.json",
  "title": "Dockyard Mod Dependency",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
