{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DockyardMods/the-dockyard/refs/heads/main/schemas/certification.schema.json",
  "title": "Certification",
  "type": "object",
  "additionalProperties": false,
  "required": ["expiresAt"],
  "properties": {
    "expiresAt": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
