{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dockyardmods.github.io/the-dockyard/schemas/mod-entry.schema.json",
  "title": "Dockyard Mod Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "repo", "manifestPath", "gameVersionId"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^https://github\\.com/DockyardMods/[A-Za-z0-9_.-]+$"
    },
    "manifestPath": {
      "type": "string",
      "minLength": 1
    },
    "gameVersionId": {
      "type": "string",
      "minLength": 1
    },
    "certification": {
      "$ref": "./certification.schema.json"
    }
  }
}
